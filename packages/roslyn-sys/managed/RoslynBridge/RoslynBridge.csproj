<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CodeGraph.RoslynBridge</RootNamespace>
    <AssemblyName>RoslynBridge</AssemblyName>
    <!--
      Runs as `dotnet RoslynBridge.dll <path>`; the Rust side captures the
      JSON graph document it prints to stdout. No apphost is generated.
    -->
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <!-- Run on newer Microsoft.NETCore.App majors (e.g. a .NET 10 SDK
         without the 8.0 runtime installed) instead of failing to launch. -->
    <RollForward>LatestMajor</RollForward>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis" Version="4.8.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>
</Project>
