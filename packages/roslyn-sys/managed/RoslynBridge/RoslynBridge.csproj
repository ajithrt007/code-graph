<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CodeGraph.RoslynBridge</RootNamespace>
    <AssemblyName>RoslynBridge</AssemblyName>
    <!--
      The Rust side spawns the published apphost executable and captures the
      JSON graph document it prints to stdout. `dotnet publish` with
      self-contained mode (see scripts/build-roslyn-bridge.sh) bundles the
      .NET runtime, so the helper runs on machines with no .NET SDK/runtime
      installed.
    -->
    <OutputType>Exe</OutputType>
    <UseAppHost>true</UseAppHost>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RuntimeIdentifiers>osx-arm64;osx-x64;linux-x64;linux-arm64;win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis" Version="4.8.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>
</Project>
